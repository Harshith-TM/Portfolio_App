<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--Label Text-->
    <style name="Custom_Label_Text">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">30dp</item>
        <item name="android:fontFamily">@font/montserrat_black</item>
        <item name="android:paddingBottom">15dp</item>
        <item name="android:textColor">@color/text_color1</item>
        <item name="android:textSize">26sp</item>
        <item name="layout_constraintWidth_max">600dp</item>
    </style>

    <!--Card View-->
    <style name="Custom_Card_View">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="cardCornerRadius">10dp</item>
        <item name="cardElevation">10dp</item>
    </style>

    <!--Project Section-->
    <style name="Custom_Project_Icon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">10dp</item>
        <item name="layout_constraintWidth_max">70dp</item>
        <item name="layout_constraintHeight_max">70dp</item>
    </style>
    <style name="Custom_Project_Title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_color1</item>
    </style>
    <style name="Custom_Project_Description">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">15dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_color1</item>
    </style>
    <style name="Custom_Details_Button" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawableEnd">@drawable/icon_arrow_right</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableTint">@color/icon</item>
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="android:padding">0dp</item>
        <item name="android:textColor">@color/text_color2</item>
        <item name="android:textSize">12sp</item>
        <item name="android:text">@string/Know_More</item>
    </style>
    <!--Project Details-->
    <style name="Project_Image">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="layout_constraintWidth_max">200dp</item>
        <item name="layout_constraintHeight_max">200dp</item>
    </style>
    <style name="Github_Repo_Button" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:layout_marginEnd">5dp</item>
        <item name="android:fontFamily">@font/montserrat_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button</item>
        <item name="android:textSize">18sp</item>
        <item name="cornerRadius">10dp</item>
        <item name="layout_constraintWidth_max">600dp</item>
        <item name="strokeColor">@color/button</item>
        <item name="strokeWidth">2dp</item>
    </style>
    <style name="Demo_Clip_Button" >
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:backgroundTint">@color/button</item>
        <item name="android:fontFamily">@font/montserrat_medium</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:textSize">18sp</item>
        <item name="cornerRadius">10dp</item>
        <item name="layout_constraintWidth_max">600dp</item>
    </style>

    <!--Skills Section-->
    <style name="Custom_Skill_Title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="android:textColor">@color/text_color1</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="Custom_Skill_Level">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="android:textColor">@color/text_color1</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!--Contact Section-->
    <style name="Custom_Contact_Title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="android:textColor">@color/text_color1</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="Custom_Contact_Id">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="android:textColor">@color/text_color1</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>